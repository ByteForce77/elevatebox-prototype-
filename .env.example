# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OmniDimension Telephony Configuration
OMNIDIM_API_KEY="your_omnidimension_api_key_here"
OMNIDIM_AGENT_ID="244379"
OMNIDIM_WEBHOOK_SECRET="your_omnidimension_webhook_secret_here"

# Meta WhatsApp Cloud API Configuration
WHATSAPP_API_KEY="your_meta_whatsapp_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"

# Candidate Details for Follow-up package (ElevateBox Assignment)
CANDIDATE_NAME="ElevateBox SDE Intern Candidate"
CANDIDATE_PHONE="+918688664337"
CANDIDATE_RESUME_URL="https://example.com/resume.pdf"
